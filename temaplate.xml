<View style="display: flex; flex-direction: row; justify-content: space-between; align-items: flex-start;">
  
  <!-- Ліва колонка: Зображення -->
  <View style="flex: 1 1 75%; margin-right: 15px;">
    <Image name="image" value="$image"/>
  </View>

  <!-- Права колонка: Інструменти та теги -->
  <View style="flex: 0 0 23%; max-width: 23%;">
     <Header value="Tags" style="font-size: 14px; margin-bottom: 5px;"/>
    <Choices name="tags" toName="image" choice="multiple" layout="vertical">
        <Choice value="d_3_5"/>
        <Choice value="d_10"/>
        <Choice value="d_8"/>
        <Choice value="d_13"/>
        <Choice value="d_11_opto"/>
        <Choice value="d_unknown"/>
        <Choice value="d_with_duct"/>
        <Choice value="d_6_unknown"/>
        <Choice value="d_8_unknown"/>
        <Choice value="winter"/>
        <Choice value="cloudy"/>
        <Choice value="sunset"/>
        <Choice value="night"/>
        <Choice value="b_green"/>
        <Choice value="b_sky"/>
        <Choice value="b_building"/>
        <Choice value="b_ground"/>
        <Choice value="b_person"/>
        <Choice value="ir"/>
        <Choice value="partial"/>
        <Choice value="occluded"/>
        <Choice value="synthetic"/>
    </Choices>

    <Header value="Classes" style="font-size: 14px; margin-top: 15px; margin-bottom: 5px;"/>
    <RectangleLabels name="label" toName="image" model_score_threshold="0.25">
      <Label value="fpv" background="#ff0d00"/>
      <Label value="bird" background="#00ff1e"/>
    </RectangleLabels>
  </View>

</View>