# Copy this file to .env and replace every value marked CHANGE_ME.

# PostgreSQL shared by Label Studio and dataset-hub
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# Label Studio
JSON_LOG=1
LABEL_STUDIO_DISABLE_SIGNUP_WITHOUT_LINK=true
LOCAL_FILES_SERVING_ENABLED=true
LOCAL_FILES_DOCUMENT_ROOT=/label-studio/data
LABEL_STUDIO_LOCAL_FILES_DOCUMENT_ROOT=/label-studio/data
CSRF_TRUSTED_ORIGINS=https://ponzel-vision.westeurope.cloudapp.azure.com

# dataset-hub
DATA_SOURCE=api
LABEL_STUDIO_API_TOKEN=
LABEL_STUDIO_PROJECT_ID=1

# dataset-hub-proxy
FRAME_EXTRACTOR_USERNAME=CHANGE_ME
FRAME_EXTRACTOR_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# Freelancer Label Studio: a separate instance and database.
# It is served at https://ponzel-vision.westeurope.cloudapp.azure.com:8443.
FREELANCE_POSTGRES_DB=postgres
FREELANCE_POSTGRES_USER=postgres
FREELANCE_POSTGRES_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_PASSWORD
FREELANCE_LABEL_STUDIO_API_TOKEN=
FREELANCE_LABEL_STUDIO_PROJECT_ID=1